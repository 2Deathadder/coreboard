#!/usr/bin/env python3
# Coreboard — démon root de refroidissement adaptatif (MSI Katana 15 B13V, firmware 1585EMS1) via ec_sys.
# Lancé par pkexec depuis coreboard ; s'arrête quand stdin est fermé, à l'expiration de la fenêtre, ou sur signal.
# Registres EC (mêmes que msi-ec sur les 158x) : 0xA0 version firmware, 0xD4 mode ventilateur, 0x98 bit 7 cooler boost.
import glob, os, select, signal, subprocess, sys, time

EC = "/sys/kernel/debug/ec/ec0/io"
FW_ADDR, FW_PREFIX = 0xA0, b"1585EMS1"
FAN_MODE, FAN_AUTO, FAN_ADV, FAN_KNOWN = 0xD4, 0x0D, 0x8D, (0x0D, 0x1D, 0x4D, 0x8D)
BOOST, BOOST_BIT = 0x98, 0x80
T_L1, T_L2, S_L1, S_L2, HYST, DOWN_S = 50.0, 65.0, 1.0, 2.5, 4.0, 10
window = int(sys.argv[1]) if len(sys.argv) > 1 else 600


def ensure_writable():
    if not os.path.exists(EC):
        subprocess.run(["modprobe", "ec_sys", "write_support=1"], check=True)
    elif open("/sys/module/ec_sys/parameters/write_support").read().strip() not in ("Y", "1"):
        subprocess.run(["rmmod", "ec_sys"], check=True)
        subprocess.run(["modprobe", "ec_sys", "write_support=1"], check=True)


ensure_writable()
ec = open(EC, "r+b", buffering=0)


def rd(a):
    ec.seek(a)
    return ec.read(1)[0]


def wr(a, v):
    ec.seek(a)
    ec.write(bytes([v]))


# garde-fou : n'écrit rien si la carte n'a pas l'agencement attendu
ec.seek(FW_ADDR)
if ec.read(len(FW_PREFIX)) != FW_PREFIX or rd(FAN_MODE) not in FAN_KNOWN:
    sys.exit("EC inattendu : abandon sans écriture")

orig_mode, orig_boost = rd(FAN_MODE), rd(BOOST) & BOOST_BIT
cpu_path = next((os.path.join(d, "temp1_input") for d in glob.glob("/sys/class/hwmon/hwmon*")
                 if open(os.path.join(d, "name")).read().strip() == "coretemp"), None)


def _nv_pm_paths():
    out = []
    for d in glob.glob("/sys/bus/pci/devices/*"):
        try:
            if open(d + "/vendor").read().strip() == "0x10de" and open(d + "/class").read().startswith("0x03"):
                out.append(d + "/power/runtime_status")
        except OSError:
            pass
    return out


nv_pm = _nv_pm_paths()


def gpu_awake():
    # nvidia-smi réveille un dGPU suspendu (D3cold) : on ne l'interroge que s'il est déjà actif
    for p in nv_pm:
        try:
            if open(p).read().strip() != "active":
                return False
        except OSError:
            pass
    return bool(nv_pm)


def temps():
    t = 0.0
    if cpu_path:
        t = int(open(cpu_path).read()) / 1000
    if not gpu_awake():
        return t
    try:
        g = subprocess.run(["nvidia-smi", "--query-gpu=temperature.gpu", "--format=csv,noheader,nounits"],
                           capture_output=True, text=True, timeout=2).stdout.strip()
        t = max(t, float(g.splitlines()[0]))
    except Exception:
        pass
    return t


def set_level(l):
    mode = FAN_ADV if l >= 1 else (orig_mode if orig_mode != FAN_ADV else FAN_AUTO)
    boost = (rd(BOOST) & ~BOOST_BIT & 0xFF) | (BOOST_BIT if l == 2 else 0)
    if rd(FAN_MODE) != mode:                            # n'écrit dans l'EC que si la valeur change
        wr(FAN_MODE, mode)
    if rd(BOOST) != boost:
        wr(BOOST, boost)


def restore():
    wr(FAN_MODE, orig_mode if orig_mode != FAN_ADV else FAN_AUTO)
    wr(BOOST, (rd(BOOST) & ~BOOST_BIT & 0xFF) | orig_boost)


def on_signal(*_):
    raise SystemExit(0)                                 # la restauration est faite une seule fois, dans finally


for s in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
    signal.signal(s, on_signal)

deadline, level, calm, last = time.time() + window, 1, 0, None
try:
    set_level(level)                                    # pré-refroidissement dès le lancement
    while time.time() < deadline:
        r, _, _ = select.select([sys.stdin], [], [], 1.0)
        if r and not sys.stdin.readline():              # stdin fermé : coreboard s'arrête
            break
        t = temps()
        slope = 0.0 if last is None else t - last
        last = t
        want = 2 if (t >= T_L2 or slope >= S_L2) else 1 if (t >= T_L1 or slope >= S_L1) else 0
        if want >= level:
            level, calm = want, 0
        else:
            thr = T_L2 if level == 2 else T_L1
            if t < thr - HYST:
                calm += 1
                if calm >= DOWN_S:
                    level, calm = level - 1, 0
            else:
                calm = 0
        set_level(level)                                # relit l'EC : réapplique si le firmware a changé le mode
        print(level, flush=True)
finally:
    restore()
